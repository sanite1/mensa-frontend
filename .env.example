VITE_API_URL=http://localhost:4000/api/v1

# URL of the admin surface (used when a customer with admin role logs in
# on the platform surface and we need to send them to admin.mensaproducts.com).
VITE_ADMIN_URL=http://localhost:3002

# URL of the platform / customer surface (used on the admin sign-in page
# to direct customers to mensaproducts.com).
VITE_PLATFORM_URL=http://localhost:3000

# ─── Feature flags ───────────────────────────────────────────────────────
# Switch any of these to `true` to surface the related promo across the
# storefront. Leaving blank or any other value keeps the feature off.

# Show the "Free delivery in Abuja & Lagos over ₦20,000" promo on the
# utility strip, shop trust strip, PDP trust block, and cart drawer
# progress bar.
VITE_FEATURE_FREE_DELIVERY=false
